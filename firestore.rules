rules_version = '2';
// Reglas de seguridad de Casa Rosada POS.
// Hacen que los permisos por rol se cumplan en el servidor, no solo en la pantalla.
service cloud.firestore {
  match /databases/{database}/documents {

    function firmado() { return request.auth != null; }
    function perfilRef() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function activo() { return firmado() && exists(perfilRef()) && get(perfilRef()).data.activo == true; }
    function rol() { return get(perfilRef()).data.rol; }
    function esAdmin() { return activo() && rol() == 'admin'; }
    function tieneRol(roles) { return activo() && rol() in roles; }
    function cambia(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }

    // Bandera de configuración inicial (se crea una sola vez con el primer administrador)
    match /config/setup {
      allow read: if true;
      allow create: if firmado()
        && !exists(/databases/$(database)/documents/config/setup)
        && getAfter(perfilRef()).data.rol == 'admin';
      allow update, delete: if false;
    }
    // Consecutivo de vales
    match /config/contador {
      allow read: if activo();
      allow create, update: if tieneRol(['admin', 'mesero', 'cajero']);
    }
    // Datos del negocio que salen en el vale
    match /config/negocio {
      allow read: if activo();
      allow create: if esAdmin() || (firmado() && !exists(/databases/$(database)/documents/config/setup));
      allow update: if esAdmin();
    }

    // Usuarios: solo el administrador los crea o modifica
    match /users/{uid} {
      allow read: if activo();
      allow create: if esAdmin()
        || (firmado() && request.auth.uid == uid
            && !exists(/databases/$(database)/documents/config/setup)
            && request.resource.data.rol == 'admin');
      allow update: if esAdmin();
      allow delete: if esAdmin() && uid != request.auth.uid;
    }
    // Qué cuenta de acceso usa cada nombre de usuario (se consulta antes de ingresar)
    match /logins/{usuario} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // Menú y mesas: todos los ven, solo el administrador los cambia
    match /productos/{id} { allow read: if activo(); allow write: if esAdmin(); }
    match /mesas/{id}     { allow read: if activo(); allow write: if esAdmin(); }
    // Menú del día (un documento por fecha): todos lo ven, solo el administrador lo define
    match /menus/{fecha}  {
      allow read: if activo();
      allow write: if esAdmin();
      // Caja puede cargar el menú del día y sus precios si el administrador le dio ese permiso
      allow create, update: if tieneRol(['cajero'])
        && get(/databases/$(database)/documents/config/negocio).data.get('permisos', {}).get('cajero', {}).get('menu', false) == true;
      // Cocina (y caja en modo mesero) solo marcan lo que «se acabó»
      allow update: if tieneRol(['cocina', 'cajero', 'mesero']) && cambia(['agotados', 'agotadosEn']);
    }
    // Clientes de domicilio (solo con autorización de datos): meseros, caja y administración
    match /clientes/{tel} {
      allow read, create, update: if tieneRol(['admin', 'mesero', 'cajero']);
      allow delete: if esAdmin();
    }

    // Vales
    match /vales/{id} {
      allow read: if activo();
      allow create: if tieneRol(['admin', 'mesero', 'cajero'])
        && request.resource.data.estado == 'abierto';
      allow update: if
        // Administrador: todo
        esAdmin()
        // Cajero: cobrar (no puede anular ni reabrir)
        || (tieneRol(['cajero']) && resource.data.estado == 'abierto'
            && request.resource.data.estado in ['abierto', 'pagado']
            && cambia(['items', 'total', 'ronda', 'actualizado', 'cocinaEstado', 'enviado', 'pidioCuenta', 'estado', 'pago', 'pagoFecha', 'cliente', 'servidoEn', 'servidoPor', 'rondaServida', 'enCaja', 'enCajaEn', 'enCajaPor', 'pagoReportado', 'cambios', 'soporte', 'despachos', 'rondaDespachada']))
        // Mesero: agregar productos y avisar que pidieron la cuenta, solo con el vale abierto
        || (tieneRol(['mesero']) && resource.data.estado == 'abierto'
            && request.resource.data.estado == 'abierto'
            && cambia(['items', 'total', 'ronda', 'actualizado', 'cocinaEstado', 'enviado', 'pidioCuenta', 'cliente', 'servidoEn', 'servidoPor', 'rondaServida', 'enCaja', 'enCajaEn', 'enCajaPor', 'pagoReportado', 'cambios', 'soporte', 'despachos', 'rondaDespachada']))
        // Cocina: solo el estado de preparación
        // Mesero o cajero: un ticket que queda sin productos se anula solo
        || (tieneRol(['mesero', 'cajero']) && resource.data.estado == 'abierto'
            && request.resource.data.estado == 'anulado' && request.resource.data.items.size() == 0
            && cambia(['items', 'total', 'cambios', 'actualizado', 'estado', 'anulacion']))
        || (tieneRol(['cocina']) && cambia(['cocinaEstado', 'actualizado', 'despachos', 'rondaDespachada']));
      allow delete: if false; // los vales nunca se borran: se anulan con motivo
    }
    // Foto del soporte de pago por QR / llave (una por ticket). Nunca se borra.
    // Id = ticket (foto del domiciliario) o ticket_caja (foto tomada en caja al cobrar)
    match /soportes/{sid} {
      allow read: if tieneRol(['admin', 'cajero', 'mesero']);
      allow create, update: if tieneRol(['admin', 'cajero', 'mesero'])
        && (request.resource.data.valeId == sid || request.resource.data.valeId + '_caja' == sid)
        && request.resource.data.img is string
        && request.resource.data.img.size() < 900000;
      allow delete: if false;
    }
    // Ingresos y egresos: solo administrador y cajero.
    // El cajero registra y corrige lo suyo del mismo día; solo el administrador anula. Nunca se borran.
    match /movimientos/{id} {
      allow read: if tieneRol(['admin', 'cajero']);
      allow create: if tieneRol(['admin', 'cajero'])
        && request.resource.data.registradoUid == request.auth.uid
        && request.resource.data.estado == 'activo'
        && request.resource.data.valor is number && request.resource.data.valor > 0
        && request.resource.data.tipo in ['ingreso', 'egreso'];
      allow update: if esAdmin()
        || (tieneRol(['cajero']) && resource.data.registradoUid == request.auth.uid
            && resource.data.estado == 'activo' && request.resource.data.estado == 'activo'
            && request.resource.data.registradoUid == resource.data.registradoUid);
      allow delete: if false;
    }
  }
}
